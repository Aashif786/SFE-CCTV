# SFE-CCTV Environment Variables
# -----------------------------

# Global Hikvision credentials (used for all configured doors if not otherwise specified)
HIKVISION_USERNAME=admin
HIKVISION_PASSWORD=your_password_here

# A JSON string mapping each Door IP to its logical Gate Name
# Ensure this remains on a single line and is valid JSON.
HIKVISION_DOORS='[{"ip": "192.168.1.231", "name": "Front Door"}, {"ip": "192.168.1.232", "name": "Back Door"}]'
